<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Document</title>
	<link rel="stylesheet" href="style.css">

	<style>

		body {
		display: flex;
		flex-direction: column;
		margin: 30px;
		padding: 0;
		background-color: #74BBCD;
		align-items: center;
		justify-content: center; 
		overflow: hidden;
		}

		.banner {
			display: flex;
			border-radius: 20px;
			width: 1800px;
			height: 300px;
			align-items: center;
			transform: translate(5px , 30px);
			justify-content: flex-end;
			box-shadow: 20px 20px 10px #5DA0BA;

			border: 1px solid rgba(255, 255, 255, 0.55);
			
			background:
				radial-gradient(circle at top left, #384952 0.1%, transparent 60%),
				radial-gradient(circle at top right, #384952 0.1%, transparent 60%);
			
		}

		.banner-s {
			height: 100%;
			transform: translateX(1300px);
		}

		.bar-t {
			display: flex;
                        width: 400px;
                        height: 950px;
                        backdrop-filter: blur(15px);
                        -webkit-backdrop-filter: blur(15px);
                        position: relative;
                        border-radius: 20px;
			
			right: 380px;
			top:350px;
			
			border: 1px solid rgba(255, 255, 255, 0.55);
			
			box-shadow: 
				0px 10px 30px rgba(70, 130, 150, 0.15),
				inset 0 1px 0 rgba(255, 255, 255, 0.7);

			background: rgba(255, 255, 255, 0.18);

			transform: translateX(-85px);

		}


		.about {
			width: 500px;
			height: 500px;
			transform: translate(-300px, 570px);
			align-items: center;
			border-radius: 10px;
			
			backdrop-filter: blur(1px);
                        -webkit-backdrop-filter: blur(5px);

			border: 1px solid rgba(255, 255, 255, 0.55);

                        box-shadow:
                                0px 10px 30px rgba(70, 130, 150, 0.15),
                                inset 0 1px 0 rgba(255, 255, 255, 0.7);

			overflow-y: auto;

		}

		.music {
			opacity: 0.8;
			backdrop-filter: blur(15px);
			-webkit-backdrop-filter: blur(15px);
			
			border: 1px solid rgba(255, 255, 255, 0.55);

                        box-shadow:
                                0px 10px 30px rgba(70, 130, 150, 0.15),
                                inset 0 1px 0 rgba(255, 255, 255, 0.7);

                        background: rgba(255, 255, 255, 0.18);

			display: flex;
			width: 400px;
			height: 300px;
			z-index: 10; 
			position: relative;
			border-radius: 10px;
			transform: translate(-40px,670px);
		}

	</style>

</head>
<body>
	<div class= "banner">
		<img src= "/home/Anu/Downloads/mikubanner-removebg-preview.png" class="banner-s">

	<div class= "bar-t">
	
	</div>
	
	</div>

	<div class= "about"> 
	</div>

	<div class= "music"> 
	</div>
	<script src="script.js"></script>
</body>
</html>
